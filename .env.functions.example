# Server-side only. Use the Supabase secrets manager; never prefix these with VITE_.
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are supplied by Supabase.
ALLOWED_ORIGINS=http://127.0.0.1:8080
APP_URL=http://127.0.0.1:8080

# Explicit Gemini model available to the configured Google project.
GEMINI_API_KEY=
GEMINI_MODEL=

# Google Calendar and Tasks OAuth web client (not Supabase social login).
# Google redirect URI: https://<project-ref>.supabase.co/functions/v1/google-oauth/callback
# It is derived from SUPABASE_URL, not APP_URL, and needs no separate env variable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Exact public university hostnames only. Empty disables remote ICS downloads.
# Verify the actual export host supplied by the institution before adding it.
ICS_ALLOWED_HOSTS=

# Recurring Stripe price IDs, validated server-side; empty prices are unavailable.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_ULTIMATE=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
