{
  "name": "Deepflow — Études et productivité",
  "short_name": "DeepFlow",
  "description": "Vos cours, vos tâches et votre concentration, au même endroit.",
  "id": "app.deepflow.productivity",
  "theme_color": "#f9f9fb",
  "background_color": "#f9f9fb",
  "display": "standalone",
  "scope": "/",
  "start_url": "/dashboard",
  "orientation": "any",
  "categories": ["productivity", "lifestyle", "education"],
  "launch_handler": {
    "client_mode": ["focus-existing", "auto"]
  },
  "icons": [
    {
      "src": "icons/icon-48x48.png",
      "sizes": "48x48",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-72x72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-96x96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-144x144.png",
      "sizes": "144x144",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-icon-72x72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/maskable-icon-96x96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/maskable-icon-144x144.png",
      "sizes": "144x144",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/maskable-icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/maskable-icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "screenshots/dashboard.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide"
    },
    {
      "src": "screenshots/tasks.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide"
    },
    {
      "src": "screenshots/mobile-dashboard.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow"
    },
    {
      "src": "screenshots/mobile-tasks.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow"
    }
  ],
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=app.deepflow",
      "id": "app.deepflow"
    },
    {
      "platform": "itunes",
      "url": "https://apps.apple.com/app/deepflow/id123456789"
    },
    {
      "platform": "webapp",
      "url": "https://deepflow.onrender.com"
    }
  ],
  "prefer_related_applications": false,
  "shortcuts": [
    {
      "name": "Tâches",
      "short_name": "Tâches",
      "description": "Ajouter une nouvelle tâche",
      "url": "/tasks",
      "icons": [
        {
          "src": "icons/tasks-shortcut.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Habitudes",
      "short_name": "Habitudes",
      "description": "Voir vos habitudes",
      "url": "/habits",
      "icons": [
        {
          "src": "icons/habits-shortcut.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Focus",
      "short_name": "Focus",
      "description": "Lancer une session de concentration",
      "url": "/focus",
      "icons": [
        {
          "src": "icons/focus-shortcut.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  "rendering": {
    "browser": ["chromium", "gecko", "webkit"]
  },
  "share_target": {
    "action": "/share-target",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "edge_side_panel": {
    "preferred_width": 400
  },
  "handle_links": "preferred",
  "dir": "auto",
  "lang": "fr",
  "display_override": ["standalone", "window-controls-overlay", "minimal-ui"],
  "file_handlers": [
    {
      "action": "/open-task",
      "accept": {
        "text/plain": [".txt"],
        "application/json": [".json"]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+deepflow",
      "url": "/protocol?url=%s"
    }
  ],
  "capture_links": "new-client"
}
